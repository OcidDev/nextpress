# Database — PostgreSQL
DATABASE_URL="postgresql://user:password@host/db?sslmode=require"

# Redis — opsional. Aktifkan penghitung di Pengaturan → Integrasi setelah diisi.
UPSTASH_REDIS_REST_URL=""
UPSTASH_REDIS_REST_TOKEN=""

# Situs
NEXT_PUBLIC_SITE_URL="http://localhost:3000"
# Maksimal gambar 1–5 MB; gunakan 4 pada Vercel (batas request 4,5 MB).
NEXT_PUBLIC_MEDIA_MAX_MB="5"

# Analytics & iklan
NEXT_PUBLIC_GA_ID=""
NEXT_PUBLIC_ADSENSE_ID=""

# Rahasia internal
# Minimal 16 karakter; cron GET /api/cron/flush-views memakai Authorization: Bearer.
CRON_SECRET=""
REVALIDATE_SECRET=""

# Autentikasi CMS — buat secret acak minimal 32 karakter
BETTER_AUTH_SECRET=""
BETTER_AUTH_URL="http://localhost:3000"
# Header IP yang DITIMPA reverse proxy (satu IP, bukan rantai); jangan buka port app
# langsung ke internet. Vercel: set x-forwarded-for. Nginx contoh: x-real-ip.
NEXTPRESS_CLIENT_IP_HEADER="x-real-ip"

# Pemulihan backup — isi terpisah hanya saat restore ke database tujuan
RESTORE_DATABASE_URL=""

# Pembaruan NextPress — repositori Release resmi.
# Kosongkan untuk memakai bawaan OcidDev/nextpress. Token opsional hanya dibaca di
# server untuk menaikkan batas API GitHub; jangan pakai token dengan cakupan tulis.
NEXTPRESS_RELEASE_OWNER=""
NEXTPRESS_RELEASE_REPOSITORY=""
NEXTPRESS_GITHUB_TOKEN=""

# Adapter deployment Vercel untuk halaman Pembaruan. Semua hanya dibaca di server.
# Token: Personal/Team token dengan izin membuat deployment pada proyek ini.
# NEXTPRESS_DEPLOY_ADAPTER kosong berarti "vercel" (satu-satunya adapter saat ini).
VERCEL_TOKEN=""
VERCEL_PROJECT_ID=""
VERCEL_REPO_ID=""
VERCEL_TEAM_ID=""
VERCEL_TEAM_SLUG=""
NEXTPRESS_DEPLOY_ADAPTER=""
